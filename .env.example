# Copy to .env and fill in. NEVER commit .env.

# --- LLM: Google Gemini (key from https://aistudio.google.com/apikey) ---------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# low | medium | high (empty = model default). "low" = faster and cheaper.
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=45

# --- Website fetching ----------------------------------------------------------
FETCH_TIMEOUT_SECONDS=15
MAX_EXTRA_PAGES=3
MAX_CONTENT_CHARS=14000

# --- Cost / abuse protection -----------------------------------------------------
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=10
# Set true only behind a reverse proxy (e.g. Render) to rate-limit by real client IP.
TRUST_PROXY_HEADERS=false

LOG_LEVEL=INFO
